# AMOprof service environment file.
#
# Install:
#   sudo install -d /etc/amoprof
#   sudo install -m 0644 systemd/amoprof.env.example /etc/amoprof/amoprof.env
#   sudo $EDITOR /etc/amoprof/amoprof.env
#
# Each AMOPROF_* variable below is the default for the matching `amoprof service`
# flag. Flags without a dedicated variable (e.g. --no-sudo, --enable-blktrace,
# --collectors, --pid, --sglang-port) go in AMOPROF_EXTRA_ARGS at the bottom.

# Prometheus /metrics HTTP endpoint port (flag: --metrics-port).
AMOPROF_METRICS_PORT=9101

# Seconds each collection cycle runs before metrics refresh (flag: --scrape-duration-s).
AMOPROF_SCRAPE_DURATION_S=30

# Base directory for per-cycle raw output (flag: --output-dir).
AMOPROF_OUTPUT_DIR=/var/lib/amoprof/results

# Block device(s) for SSD/NVMe collectors (flag: --ssd-device).
# Accepts a single device or a comma-separated list of devices to monitor
# multiple SSDs in the same run, e.g. /dev/nvme0n1,/dev/nvme1n1.
# The first device is the primary L3 device.
AMOPROF_SSD_DEVICE=/dev/nvme0n1

# Mount path for HiCache df stats (flag: --hicache-path).
AMOPROF_HICACHE_PATH=/mnt/sglang_hicache

# SGLang server host when --sglang-port is set (flag: --sglang-host).
AMOPROF_SGLANG_HOST=127.0.0.1

# How often to re-parse live blktrace data (flag: --blkparse-interval-s).
AMOPROF_BLKPARSE_INTERVAL_S=10

# Binaries for the optional privileged collectors.
AMOPROF_BLKTRACE_BIN=blktrace
AMOPROF_BLKPARSE_BIN=blkparse
AMOPROF_BIOSNOOP_BIN=biosnoop-bpfcc
AMOPROF_AMDUPROF_PCM_BIN=/opt/AMDuProf_5.2-606/bin/AMDuProfPcm

# Extra flags with no dedicated env var. Examples:
#   --collectors all                       (all always-on collectors)
#   --collectors dram                      (DRAM collector only)
#   --collectors dram,gpu,vmstat           (a subset)
#   --collectors gpu,dram,vmstat,iostat,smart
#   --enable-blktrace --enable-biosnoop
#   --metrics-host 0.0.0.0
#   --no-sudo            (only when the service already runs as root)
AMOPROF_EXTRA_ARGS="--metrics-host 0.0.0.0 --collectors all"
